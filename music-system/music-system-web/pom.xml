<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.whf</groupId>
        <artifactId>music-system</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>music-system-web</artifactId>
    <name>music-system-web</name>
    <description>music-system-web</description>
    <dependencies>
        <dependency>
            <groupId>com.whf</groupId>
            <artifactId>music-system-service</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 日志 -->
        <dependency>
            <groupId>com.whf</groupId>
            <artifactId>music-common-log</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--nacos 注册中心-->
        <dependency>
            <groupId>com.whf</groupId>
            <artifactId>music-common-nacos</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--sentinel 限流-->
        <dependency>
            <groupId>com.whf</groupId>
            <artifactId>music-common-sentinel</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
